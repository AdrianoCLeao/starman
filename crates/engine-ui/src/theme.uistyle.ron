// Built-in default theme: applied before project style sheets, so any
// project rule of equal or higher specificity overrides it.
(
    version: 1,
    rules: [
        (selector: "Panel", style: (text_color: Some((0.92, 0.93, 0.95, 1.0)), font_size: Some(20.0), line_height: Some(1.25), font: Some("Inter"))),
        (selector: "Text", style: (flex_shrink: Some(1.0))),
        (selector: "Button", style: (
            direction: Some(Row), justify_content: Some(Center), align_items: Some(Center),
            padding: Some((left: Px(18.0), right: Px(18.0), top: Px(8.0), bottom: Px(8.0))),
            min_height: Some(Px(40.0)),
            background: Some((0.16, 0.18, 0.22, 0.92)), border_color: Some((0.30, 0.34, 0.42, 1.0)),
            border_width: Some(1.0), corner_radius: Some(6.0), transition: Some(0.08),
        )),
        (selector: "Button:hover", style: (background: Some((0.22, 0.25, 0.31, 0.95)))),
        (selector: "Button:focused", style: (border_color: Some((0.36, 0.62, 1.0, 1.0)), border_width: Some(2.0))),
        (selector: "Button:pressed", style: (background: Some((0.12, 0.13, 0.16, 1.0)))),
        (selector: ":disabled", style: (opacity: Some(0.45))),
        (selector: ".label", style: (text_align: Some(Center))),

        (selector: "Toggle", style: (direction: Some(Row), align_items: Some(Center), gap: Some((10.0, 10.0)), min_height: Some(Px(32.0)))),
        (selector: ".toggle-box", style: (
            width: Some(Px(22.0)), height: Some(Px(22.0)), flex_shrink: Some(0.0),
            background: Some((0.12, 0.13, 0.16, 1.0)), border_color: Some((0.36, 0.40, 0.48, 1.0)),
            border_width: Some(1.0), corner_radius: Some(4.0),
        )),
        (selector: "Toggle:focused", style: (background: Some((0.36, 0.62, 1.0, 0.18)), corner_radius: Some(4.0))),
        (selector: ".toggle-check", style: (
            position: Some(Absolute), inset: Some((left: Px(5.0), right: Px(5.0), top: Px(5.0), bottom: Px(5.0))),
            background: Some((0.36, 0.62, 1.0, 1.0)), corner_radius: Some(2.0),
        )),

        (selector: "Slider", style: (
            min_width: Some(Px(200.0)), height: Some(Px(22.0)),
            background: Some((0.12, 0.13, 0.16, 1.0)), corner_radius: Some(11.0),
            border_color: Some((0.30, 0.34, 0.42, 1.0)), border_width: Some(1.0),
        )),
        (selector: "Slider:focused", style: (border_color: Some((0.36, 0.62, 1.0, 1.0)), border_width: Some(2.0))),
        (selector: ".slider-fill", style: (
            position: Some(Absolute), inset: Some((left: Px(0.0), top: Px(0.0), bottom: Px(0.0))),
            background: Some((0.36, 0.62, 1.0, 0.85)), corner_radius: Some(11.0),
        )),

        (selector: "ProgressBar", style: (
            min_width: Some(Px(120.0)), height: Some(Px(14.0)),
            background: Some((0.10, 0.10, 0.12, 0.85)), corner_radius: Some(7.0),
        )),
        (selector: ".progress-fill", style: (
            position: Some(Absolute), inset: Some((left: Px(0.0), top: Px(0.0), bottom: Px(0.0))),
            background: Some((0.86, 0.24, 0.24, 1.0)), corner_radius: Some(7.0),
        )),

        (selector: "TextInput", style: (
            min_width: Some(Px(220.0)), min_height: Some(Px(36.0)), align_items: Some(Center),
            padding: Some((left: Px(10.0), right: Px(10.0), top: Px(6.0), bottom: Px(6.0))),
            background: Some((0.08, 0.09, 0.11, 1.0)), border_color: Some((0.30, 0.34, 0.42, 1.0)),
            border_width: Some(1.0), corner_radius: Some(4.0), clip: Some(true),
        )),
        (selector: "TextInput:focused", style: (border_color: Some((0.36, 0.62, 1.0, 1.0)), border_width: Some(2.0))),
        (selector: ".placeholder", style: (text_color: Some((0.55, 0.58, 0.64, 1.0)))),

        (selector: "ScrollView", style: (clip: Some(true), direction: Some(Column))),
        (selector: "List", style: (direction: Some(Column), gap: Some((6.0, 6.0)))),
    ],
)
